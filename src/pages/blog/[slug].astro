---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, image, imageAlt } = post.data;
const url = `https://healthrenovation.com.au/blog/${post.id}/`;
const schema = [
  articleSchema(title, description, date, url),
  breadcrumbSchema([
    { name: 'Home', url: 'https://healthrenovation.com.au/' },
    { name: 'Articles', url: 'https://healthrenovation.com.au/blog/' },
    { name: title, url },
  ]),
];
---
<Base title={title} description={description} image={image?.src} type="article" schema={schema} noindex={post.data.draft}>
  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Articles</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </div>
  </nav>
  <article class="post-article section-pad">
    <div class="container narrow-container">
      <header class="post-header">
        <p class="post-card-meta"><time datetime={date.toISOString()}>{formatDate(date)}</time> · {site.practitioner}</p>
        <h1 class="section-title">{title}</h1>
        <p class="section-lead">{description}</p>
      </header>
      {image && <Image src={image} alt={imageAlt ?? ''} widths={[700, 1400]} sizes="(max-width: 760px) 100vw, 700px" class="post-hero-image" loading="eager" fetchpriority="high" />}
      <div class="rich-text post-content"><Content /></div>
      <aside class="service-info-card post-cta">
        <h2 class="info-card-title">Want to talk it through?</h2>
        <p class="info-card-text">Book a free discovery call with {site.practitioner}.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={`tel:${site.phone.replace(/\s/g, '')}`}>Call {site.phone}</a>
          <a class="btn btn-ghost" href="/contact/">Send a Message</a>
        </div>
      </aside>
    </div>
  </article>
</Base>
