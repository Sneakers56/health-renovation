---
import Base from '../../layouts/Base.astro';
import PageRender from '../../puck/PageRender';
import { getPosts } from '../../lib/content';
import { buildSiteMeta, imageFiles } from '../../lib/siteMeta';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const metadata = await buildSiteMeta({ pageData: post.doc, current: post.id });
const url = `https://healthrenovation.com.au/blog/${post.id}/`;
const ogImage = post.image && imageFiles[post.image] ? imageFiles[post.image].src : undefined;
const schema = [
  articleSchema(post.title, post.description, post.date, url),
  breadcrumbSchema([
    { name: 'Home', url: 'https://healthrenovation.com.au/' },
    { name: 'Articles', url: 'https://healthrenovation.com.au/blog/' },
    { name: post.title, url },
  ]),
];
---
<Base title={post.title} description={post.description} image={ogImage} type="article" schema={schema} noindex={post.draft}>
  <PageRender kind="post" data={post.doc} metadata={metadata} />
</Base>
