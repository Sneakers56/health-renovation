---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import site from '../../data/site.json';

const posts = await getPublishedPosts();
---
<Base title="Articles" description={`Articles on natural health, stress, pain and wellbeing from ${site.practitioner} at ${site.name}, ${site.suburb}.`}>
  <section class="page-hero page-hero--teal">
    <div class="container">
      <div class="page-hero-content">
        <span class="section-eyebrow light">Blog</span>
        <h1 class="page-title light">Articles</h1>
        <p class="page-hero-subtitle">Insights on natural health and wellbeing.</p>
      </div>
    </div>
  </section>
  <section class="section-pad">
    <div class="container">
      {posts.length > 0 ? (
        <div class="posts-grid">{posts.map((post) => <PostCard post={post} />)}</div>
      ) : (
        <p class="text-center section-lead">No articles yet – check back soon.</p>
      )}
    </div>
  </section>
</Base>
