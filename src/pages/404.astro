---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" description="The page you're looking for couldn't be found." noindex>
  <section class="page-hero page-hero--teal">
    <div class="container">
      <div class="page-hero-content">
        <h1 class="page-title light">Page not found</h1>
        <p class="page-hero-subtitle">Sorry, that page doesn't exist or has moved.</p>
      </div>
    </div>
  </section>
  <section class="section-pad">
    <div class="container narrow-container text-center">
      <div class="cta-actions">
        <a class="btn btn-primary" href="/">Go to Home</a>
        <a class="btn btn-ghost" href="/services/">View Services</a>
        <a class="btn btn-ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>
