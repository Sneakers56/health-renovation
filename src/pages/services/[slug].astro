---
import Base from '../../layouts/Base.astro';
import PageRender from '../../puck/PageRender';
import site from '../../data/site.json';
import { getServices } from '../../lib/content';
import { buildSiteMeta } from '../../lib/siteMeta';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const metadata = await buildSiteMeta({ pageData: service.doc, current: service.id });
const url = `https://healthrenovation.com.au/services/${service.id}/`;
const schema = [
  serviceSchema(`${service.title} in ${site.suburb}`, service.tagline, url),
  breadcrumbSchema([
    { name: 'Home', url: 'https://healthrenovation.com.au/' },
    { name: 'Services', url: 'https://healthrenovation.com.au/services/' },
    { name: service.title, url },
  ]),
];
---
<Base
  title={service.seoTitle || `${service.title} in ${site.suburb}`}
  description={service.seoDescription || `${service.title} in ${site.suburb}, Victoria with ${site.practitioner}. ${service.tagline} Sessions ${service.duration}. Call ${site.phone}.`}
  noindex={service.noindex}
  schema={schema}
>
  <PageRender kind="service" data={service.doc} metadata={metadata} />
</Base>
