---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/posts';

const { post } = Astro.props;
const { title, description, date, image, imageAlt, draft } = post.data;
---
<article class="post-card">
  {image && (
    <a class="post-card-thumbnail" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
      <Image src={image} alt={imageAlt ?? ''} widths={[400, 800]} sizes="(max-width: 960px) 100vw, 33vw" />
    </a>
  )}
  <div class="post-card-body">
    <p class="post-card-meta"><time datetime={date.toISOString()}>{formatDate(date)}</time>{draft && ' · Draft'}</p>
    <h3 class="post-card-title"><a href={`/blog/${post.id}/`}>{title}</a></h3>
    <p class="post-card-excerpt">{description}</p>
  </div>
</article>
